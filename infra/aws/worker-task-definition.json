{
  "family": "levla-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "ARN_EXECUTION_ROLE",
  "taskRoleArn": "ARN_TASK_ROLE",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "ACCOUNT.dkr.ecr.REGION.amazonaws.com/levla-backend:TAG",
      "essential": true,
      "entryPoint": ["python"],
      "command": ["-m", "app.worker"],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "S3_AUDIO_BUCKET", "value": "YOUR_AUDIO_BUCKET" },
        { "name": "GENERATE_WORKERS", "value": "4" },
        { "name": "SKIP_SEED", "value": "true" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "ARN_SECRET:DATABASE_URL::" },
        { "name": "OPENROUTER_API_KEY", "valueFrom": "ARN_SECRET:OPENROUTER_API_KEY::" },
        { "name": "AZURE_SPEECH_KEY", "valueFrom": "ARN_SECRET:AZURE_SPEECH_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/levla-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
